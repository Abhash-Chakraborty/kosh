<% content_for :page_header do %>
  <div class="flex flex-wrap items-start justify-between gap-3 mb-6">
    <div class="space-y-1 min-w-0">
      <h1 class="text-xl lg:text-3xl font-medium text-primary"><%= t(".title") %></h1>
      <p class="text-sm lg:text-base text-secondary"><%= t(".subtitle") %></p>
    </div>
    <% if (@projects.any? || @archived_count.positive?) && !Current.user.guest? %>
      <%= render DS::Link.new(text: t(".new"), variant: "primary", href: new_project_path, icon: "plus", frame: :modal) %>
    <% end %>
  </div>
<% end %>

<div class="space-y-4 pb-12">
  <% if @show_archived %>
    <h2 class="text-sm font-medium text-secondary"><%= t(".archived_heading") %></h2>
  <% end %>

  <% if @projects.any? %>
    <% @project_groups.each do |status, projects| %>
      <section class="space-y-2" data-project-status="<%= status %>">
        <% if @project_groups.size > 1 %>
          <h2 class="text-sm font-medium text-secondary"><%= t("projects.statuses.#{status}") %></h2>
        <% end %>
        <div class="grid grid-cols-1 md:grid-cols-2 2xl:grid-cols-3 gap-3">
          <% projects.each do |project| %>
            <%= render "projects/project", project: project, totals: project.totals(accounts: @accounts) %>
          <% end %>
        </div>
      </section>
    <% end %>
  <% elsif @show_archived %>
    <%= render DS::Card.new(class: "p-4") do %>
      <p class="text-sm text-secondary"><%= t(".empty_archived") %></p>
    <% end %>
  <% else %>
    <div class="bg-container rounded-xl shadow-border-xs">
      <%= render DS::EmptyState.new(icon: "briefcase", title: t(".empty_title"), description: t(".empty_description")) do |empty| %>
        <% unless Current.user.guest? %>
          <% empty.with_action do %>
            <%= render DS::Link.new(text: t(".new"), variant: "primary", href: new_project_path, icon: "plus", frame: :modal) %>
          <% end %>
        <% end %>
      <% end %>
    </div>
  <% end %>

  <% if @show_archived %>
    <%= render DS::Link.new(text: t(".show_active"), variant: "ghost", icon: "arrow-left", href: projects_path) %>
  <% elsif @archived_count.positive? %>
    <%= render DS::Link.new(text: t(".show_archived", count: @archived_count), variant: "ghost", icon: "archive", href: projects_path(archived: 1)) %>
  <% end %>
</div>
