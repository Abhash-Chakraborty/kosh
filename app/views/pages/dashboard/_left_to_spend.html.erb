<%# locals: (budget:, open_questions:) %>
<%# What's left of this month's budget, and the payments waiting for an answer. %>
<div class="grid grid-cols-1 sm:grid-cols-2 gap-3 mb-6">
  <%= render DS::Card.new(class: "gap-1") do %>
    <p class="text-sm text-secondary"><%= t("pages.dashboard.left_to_spend.title") %></p>
    <% if budget %>
      <% left = budget.available_to_spend_money %>
      <p class="text-2xl font-medium privacy-sensitive <%= left.negative? ? "text-destructive" : "text-primary" %>"><%= left.format %></p>
      <p class="text-xs text-secondary">
        <%= t("pages.dashboard.left_to_spend.detail", budget: budget.budgeted_spending_money.format, spent: budget.actual_spending_money.format) %>
      </p>
    <% else %>
      <p class="text-sm text-primary">
        <%= link_to t("pages.dashboard.left_to_spend.no_budget"), budgets_path, class: "underline" %>
      </p>
    <% end %>
  <% end %>

  <%= render DS::Card.new(class: "gap-1") do %>
    <p class="text-sm text-secondary"><%= t("pages.dashboard.left_to_spend.questions_title") %></p>
    <% if open_questions.positive? %>
      <p class="text-2xl font-medium text-primary"><%= open_questions %></p>
      <%= link_to t("pages.dashboard.left_to_spend.answer", count: open_questions), payment_questions_path, class: "text-xs text-primary underline" %>
    <% else %>
      <p class="text-sm text-primary"><%= t("pages.dashboard.left_to_spend.no_questions") %></p>
    <% end %>
  <% end %>
</div>
